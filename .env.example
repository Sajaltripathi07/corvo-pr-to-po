# Optional: enables AI reading of policy amendments and chat messages (the app also works without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Where the SQLite file lives (mount a persistent disk here when hosting)
DATABASE_PATH=/data/corvo.db
# Optional auto-load of master data at first start (folder of the kit CSVs, or a private zip URL). Never commit the data.
DATA_DIR=
SEED_ZIP_URL=
